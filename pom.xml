<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ========== ИНФОРМАЦИЯ О ПРОЕКТЕ ========== -->
    <groupId>org.example</groupId>           <!-- Группа/пакет проекта -->
    <artifactId>Diplom_2</artifactId>    <!-- Название проекта -->
    <version>1.0-SNAPSHOT</version>          <!-- Версия (SNAPSHOT = черновик) -->

    <!-- ========== ГЛОБАЛЬНЫЕ НАСТРОЙКИ ========== -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>   <!-- Версия Java -->
        <maven.compiler.target>17</maven.compiler.target>   <!-- Целевая версия Java -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aspectj.version>1.9.9.1</aspectj.version>          <!-- Версия AspectJ -->
        <allure.version>2.15.0</allure.version>              <!-- Версия Allure -->
        <junit.version>5.9.2</junit.version>                 <!-- Версия JUnit -->
    </properties>

    <!-- ========== ЗАВИСИМОСТИ (БИБЛИОТЕКИ) ========== -->
    <dependencies>
        <!-- Lombok: сокращает код (геттеры, сеттеры и т.д.) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>          <!-- Не включается в финальный JAR -->
        </dependency>

        <!-- JUnit 5: для написания тестов -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>               <!-- Только для тестов -->
        </dependency>
        <!-- JUnit 5: параметризованные тесты -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5: движок для запуска тестов -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Rest Assured: тестирование API (HTTP запросы) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>4.4.0</version>
        </dependency>

        <!-- Gson: работа с JSON -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.8.9</version>
        </dependency>

        <!-- Allure JUnit 5: интеграция Allure с JUnit -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <version>${allure.version}</version>
        </dependency>
        <!-- Allure Rest Assured: логи запросов в Allure -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
        </dependency>
        <!--Faker генерации фиктивных (но реалистичных) данных-->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>2.0.1</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <!-- ========== СБОРКА ПРОЕКТА ========== -->
    <build>
        <plugins>
            <!-- Плагин для запуска тестов -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version> 3.5.2</version>
                <configuration>
                    <testFailureIgnore>false</testFailureIgnore>  <!-- Останавливаться при ошибках -->
                    <argLine>                                      <!-- Подключение AspectJ для Allure -->
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                    <properties>
                        <property>
                            <name>listener</name>
                            <value>io.qameta.allure.junit5.AllureJunit5</value>  <!-- Слушатель Allure -->
                        </property>
                    </properties>
                    <systemProperties>
                        <property>
                            <name>allure.results.directory</name>
                            <value>${project.build.directory}/allure-results</value>  <!-- Папка для отчетов -->
                        </property>
                    </systemProperties>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>  <!-- Для работы Allure -->
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Плагин Allure: генерация отчетов -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.10.0</version>
                <configuration>
                    <reportVersion>2.15.0</reportVersion>  <!-- Версия отчета -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>